<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>KartChrono.Cli</RootNamespace>
    <AssemblyName>KartChrono.Cli</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>KartChrono.Cli</PackageId>
    <ToolCommandName>kartchrono</ToolCommandName>
    <Authors>Dmitry Kurochkin</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kudima03/kartchrono-cli</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KartChrono\KartChrono.csproj" />
    <ProjectReference Include="..\KartChrono.Abstractions\KartChrono.Abstractions.csproj" />
  </ItemGroup>
</Project>
